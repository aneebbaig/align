# Copy to .env.local and fill in:  cp .env.example .env.local
# Generate secrets with:  openssl rand -base64 32

# --- Database ---------------------------------------------------------------
# Neon: pooled URL for the running app. Local Docker Postgres (docker compose up -d db):
#   postgresql://align:align@localhost:5434/align_dev
DATABASE_URL="postgresql://user:password@host:5432/dbname"
# Neon direct (non-pooler) URL, used by `prisma migrate deploy` in production.
# Same as DATABASE_URL for local Postgres.
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/dbname"

# --- Auth -------------------------------------------------------------------
AUTH_SECRET=""
# Optional - falls back to AUTH_SECRET when unset.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# --- Seeded logins (pnpm seed) ----------------------------------------------
# Min 8 chars. Leave a password empty and the seed prints a random one once.
USER1_EMAIL="admin@example.com"
USER1_PASSWORD=""
USER1_NAME="Admin"
USER2_EMAIL="member@example.com"
USER2_PASSWORD=""
USER2_NAME="Member"

# --- Optional ---------------------------------------------------------------
# Override the display name everywhere in the UI.
NEXT_PUBLIC_APP_NAME="Align"
# Gmail for email alerts and the daily digest (16-char Google App Password).
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# Authenticates calls to /api/cron/daily.
CRON_SECRET=""
