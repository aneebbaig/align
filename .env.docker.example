# Copy to .env next to docker-compose.yml:  cp .env.docker.example .env
# then: docker compose up --build   ->  http://localhost:3000
# Generate secrets with:  openssl rand -base64 32

# Required
AUTH_SECRET=""
BETTER_AUTH_SECRET=""

# First admin, created on start when SEED_ON_START=true. Set a strong password
# (min 8 chars) - left empty, compose falls back to the weak "changeme123".
USER1_EMAIL="admin@example.com"
USER1_PASSWORD=""
USER1_NAME="Admin"
SEED_ON_START=true

# Optional
NEXT_PUBLIC_APP_NAME="Align"
BETTER_AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
# Postgres credentials (defaults: align / align / align_dev)
# POSTGRES_USER=align
# POSTGRES_PASSWORD=align
# POSTGRES_DB=align_dev
